<?xml version="1.0" encoding="utf-8"?>
<!-- A camera capture is staged under <cacheDir>/captures/ and handed to the
     camera app as a content URI, so that subtree is all this provider exposes.
     The cache is the right home: the bytes are read back into an attachment as
     soon as the capture returns, and the system may clear them after that. -->
<paths>
    <cache-path
        name="captures"
        path="captures/" />
</paths>
