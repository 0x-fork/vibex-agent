<?xml version="1.0" encoding="utf-8"?>
<!-- Long-pressing the launcher icon opens a session without walking through
     the session list first. The action is handled by GpuiHostActivity, which
     tells the panel to show the new-session page. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutId="new_session"
        android:shortcutLongLabel="@string/shortcut_new_session_long"
        android:shortcutShortLabel="@string/shortcut_new_session">
        <intent
            android:action="ai.vibex.mobile.NEW_SESSION"
            android:targetClass="ai.vibex.mobile.GpuiHostActivity"
            android:targetPackage="ai.vibex.mobile" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
</shortcuts>
